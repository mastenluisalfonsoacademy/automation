# Telegram Bot Token (von @BotFather erhalten)
TELEGRAM_TOKEN=dein_bot_token_hier

# Deine Telegram Chat-ID (von @userinfobot erhalten)
TELEGRAM_CHAT_ID=deine_chat_id_hier

# Uhrzeit der täglichen Überprüfung
CHECK_HOUR=9
CHECK_MINUTE=0

# Zeitzone
TIMEZONE=Europe/Berlin

# Optional: Instagram-Login für bessere Zuverlässigkeit (verhindert Rate-Limiting)
# INSTAGRAM_USERNAME=dein_instagram_username
# INSTAGRAM_PASSWORD=dein_instagram_passwort
